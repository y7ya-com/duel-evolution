{
  "name": "@duel-evolution/experimental-client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/run.mjs vite --host 127.0.0.1",
    "build": "node tools/run.mjs tsc --noEmit && node tools/run.mjs vite build",
    "typecheck": "node tools/run.mjs tsc --noEmit",
    "test": "node tools/run.mjs vitest run",
    "parity": "node tools/parity.mjs",
    "catalog": "node tools/catalog.mjs",
    "cards": "node tools/card-data.mjs",
    "card-texts": "node tools/card-text.mjs",
    "recipes": "node tools/recipes.mjs",
    "smoke": "node tools/browser-smoke.mjs",
    "test:parity-infrastructure": "node tools/parity.mjs --test",
    "world": "node tools/world.mjs",
    "texts": "node tools/duel-texts.mjs",
    "pretest": "npm run build",
    "presmoke": "npm run build"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "2.1.9"
  }
}
