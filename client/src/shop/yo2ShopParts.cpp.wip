namespace {
// One of the plate's texts: right-aligned, 200 x 24, at (12, y); the shadow is hidden.
void makeMileageText(CTaskPtr<CWindowTaskShadowText>& ptr, CTaskUser* user, CElement* parent,
                     IWindowTaskMediator* mediator, float y) {
    ptr.setUser(user);
    ptr.set(CWindowTaskShadowText::create(parent, mediator));
    windowNameTask(ptr.task(), "決定テキスト");  // "decision text"
    CWindowTaskShadowText* t = ptr.get();
    t->inheritTransform_ = true;
    t->shadow()->hide();
    t->setPos(12, y);
    t->setArea(200, 24);
    t->setAlign(2);
    t->setFontSize(24);
    t->baseZ_ = 1.0f;
    t->pos_.z = 1.0f;
}
}  // namespace

// @yo2 0x00aea260 CShopMileagePlate::onInit: the plate (shop_money_01) and its two texts
bool CShopMileagePlate::onInit() {
    base_.setUser(this);
    base_.set(CElement::newChild(layer_, kPriority));
    windowNameTask(base_.task(), "");
    base_.get()->inheritTransform_ = true;

    plate_.setUser(this);
    plate_.set(CSpriteElm::newChild(base_.get(), kPriority));
    windowNameTask(plate_.task(), "商品の種類を載せるプレート");  // "the plate the item kinds go on"
    plate_.get()->inheritTransform_ = true;
    plate_.get()->setTexture("data/shop/shop_money_01_c01.png");
    plate_.get()->pos_ = {0, 0, 0};
    plate_.get()->setDrawMode(CElement::BLEND);

    makeMileageText(top_, this, base_.get(), this, 7);
    makeMileageText(bottom_, this, base_.get(), this, 48);
    return true;
}

