// ================================================================ CShopConfirmWindow

CShopConfirmWindow::CShopConfirmWindow() = default;

// @yo2 0x00aeb770 CShopConfirmWindow::~CShopConfirmWindow
// @yo2 0x00aeb740 CShopConfirmWindow deleting destructor
CShopConfirmWindow::~CShopConfirmWindow() = default;

// @yo2 0x00aeb4d0 CShopConfirmWindow::New
CShopConfirmWindow* CShopConfirmWindow::newChild(CTask* parent, CTask* layer) {
    auto* w = new CShopConfirmWindow;
    w->layer_ = layer;
    return dynamic_cast<CShopConfirmWindow*>(w->create(parent, kPriority));
}

namespace {
CWindowTaskText* makeText(CTaskPtr<CWindowTaskText>& ptr, CTaskUser* user, CElement* parent,
                          IWindowTaskMediator* mediator, const char* name) {
    ptr.setUser(user);
    ptr.set(CWindowTaskText::create(parent, mediator));
    windowNameTask(ptr.task(), name);
    return ptr.get();
}

CWindowTaskPictureSwitch* makeButton(CTaskPtr<CWindowTaskPictureSwitch>& ptr, CTaskUser* user, CElement* parent,
                                     CTask* owner, IWindowTaskMediator* mediator, const char* name, float x) {
    ptr.setUser(user);
    ptr.set(CWindowTaskPictureSwitch::create(parent, owner, mediator));
    windowNameTask(ptr.task(), name);
    CWindowTaskPictureSwitch* b = ptr.get();
    b->setImages("data/shop/shop_btn2_01_c01.png", "data/shop/shop_btn2_02_c01.png", "data/shop/shop_btn2_03_c01.png",
                 "data/shop/shop_btn2_03_c01.png");
    b->pos_ = {x, 217, 1};
    return b;
}
}  // namespace

// @yo2 0x00aeb920 CShopConfirmWindow::onInit: frame, OK / Cancel, the message, ten item lines and a scroll bar
bool CShopConfirmWindow::onInit() {
    result_ = NONE;
    base_.setUser(this);
    base_.set(CElement::newChild(layer_, kPriority));
    base_.get()->pos_ = {300, 330, 51005};

    frame_.setUser(this);
    frame_.set(CSpriteElm::newChild(base_.get(), kPriority));
    windowNameTask(frame_.task(), "確認ウィンドウ");  // "confirmation window"
    frame_.get()->setTexture("data/shop/shop_win_01_c00.png");
    frame_.get()->inheritTransform_ = true;
    frame_.get()->pos_ = {0, 0, 0};

    makeButton(ok_, this, base_.get(), this, this, "確認ウィンドウOKボタン", 39);
    CWindowTaskText* t = makeText(okText_, this, base_.get(), this, "確認ウィンドウOKテキスト");
    t->setTextId(4000);  // "OK"
    t->setPos(39, 224);
    t->setArea(110, 32);
    t->setAlign(1);
    t->z_ = 3.0f;
    t->pos_.z = 3.0f;

    makeButton(cancel_, this, base_.get(), this, this, "確認ウィンドウCancelボタン", 338);
    t = makeText(cancelText_, this, base_.get(), this, "確認ウィンドウOKテキスト");  // (sic)
    t->setTextId(0xfa1);  // "Cancel"
    t->setPos(338, 224);
    t->setArea(110, 32);
    t->setAlign(1);
    t->z_ = 3.0f;
    t->pos_.z = 3.0f;

    scroll_.setUser(this);
    scroll_.set(CWindowTaskScroll::create(base_.get(), this, 0));
    windowNameTask(scroll_.task(), "確認ウィンドウスクロールバー");  // "confirmation window scroll bar"
    scroll_.get()->x_ = 448;
    scroll_.get()->y_ = 17;
    scroll_.get()->length_ = 190;
    scroll_.get()->baseZ_ = 1.0f;
    scroll_.get()->layout();

    t = makeText(message_, this, base_.get(), this, "確認ウィンドウの確認テキスト");  // "confirmation text"
    t->setFontSize(15);
    t->setLineGap(1);
    t->setPos(16, 16);
    t->setArea(300, 32);
    t->z_ = 1.0f;
    t->pos_.z = 1.0f;

    for (int i = 0; i < kLines; ++i) {
        t = makeText(lines_[i], this, base_.get(), this, "確認ウィンドウ商品名リスト");  // "item name list"
        t->setFontSize(16);
        t->setPos(24, static_cast<float>(48 + 16 * i));
        t->setArea(512, 16);
        t->z_ = 1.0f;
        t->pos_.z = 1.0f;
    }
    return true;
}

// @yo2 0x00aecef0 CShopConfirmWindow::onMain
bool CShopConfirmWindow::onMain() { return true; }

// @yo2 0x00aed6c0 CShopConfirmWindow::onDestroy
void CShopConfirmWindow::onDestroy() {
    if (base_.task())
        base_.get()->destroy(kShopFile, 0x3fa);
}

// @yo2 0x00aeb720 CShopConfirmWindow::onControlCommand (empty)
void CShopConfirmWindow::onControlCommand(IWindowTaskColleague*) {}

// @yo2 0x00aed480 CShopConfirmWindow::onControlEvent: OK / Cancel (with their sounds), or the scroll bar moved
void CShopConfirmWindow::onControlEvent(IWindowTaskColleague* sender) {
    if (base_.get()->isLocked(2))  // hidden
        return;
    if (sender == static_cast<IWindowTaskColleague*>(dynamic_cast<CWindowTaskPictureSwitch*>(ok_.task()))) {
        result_ = OK;
        appPlaySound(0x10000001, 0);
        return;
    }
    if (sender == static_cast<IWindowTaskColleague*>(dynamic_cast<CWindowTaskPictureSwitch*>(cancel_.task()))) {
        result_ = CANCEL;
        appPlaySound(0x10000002, 0);
        return;
    }
    if (sender == static_cast<IWindowTaskColleague*>(dynamic_cast<CWindowTaskScroll*>(scroll_.task())))
        showLines();
}

// @yo2 0x00aecf10 CShopConfirmWindow::setCart: one line per cart line ("<name>  x<count>  <count * cost>MP"),
// the scroll bar over the ones past ten, and the total
void CShopConfirmWindow::setCart(ShopVec<ShopCartLine> cart) {
    for (auto& line : lines_)
        line.get()->setText(u"");
    cart_ = cart;
    lineTexts_.clear();
    int32_t total = 0;
    for (const ShopCartLine& l : cart_) {
        std::u16string name = yo2Widen(shopItemName(l.item).c_str());
        lineTexts_.push_back(yo2FormatW(u"%s@>320/x%d@>360/%dMP", name.c_str(), l.count,
                                        l.count * static_cast<int32_t>(l.item.cost)));
        total += static_cast<int32_t>(l.item.cost) * l.count;
    }
    scroll_.get()->setMax(static_cast<int32_t>(lineTexts_.size()) - kLines);
    showLines();
    total_ = total;
}

// @yo2 0x00aed5b0 CShopConfirmWindow::showLines: the ten lines from the scroll position on
void CShopConfirmWindow::showLines() {
    for (int i = 0; i < kLines; ++i) {
        size_t at = static_cast<size_t>(scroll_.get()->value_ + i);
        if (lineTexts_.size() <= at)
            return;
        lines_[i].get()->setText(lineTexts_[at].c_str());
    }
}

// @yo2 0x00aed410 CShopConfirmWindow::setVisible (only the lock bit: the window keeps drawing state)
void CShopConfirmWindow::setVisible(bool on) {
    if (on) {
        TaskLockFlags::of(base_.get()) &= ~2u;
        lockFlags_ &= ~2u;
    } else {
        TaskLockFlags::of(base_.get()) |= 2u;
        lockFlags_ |= 2u;
    }
}

// @yo2 0x00aed710 CShopConfirmWindow::message: the "buy for <total> MP?" text
vc6::string CShopConfirmWindow::message() const { return shopConfirmMessage(total_); }

struct CShopConfirmWindow::Layout {
